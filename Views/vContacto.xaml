<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="djaramilloT3.Views.vContacto"
             Title="vContacto"
             BackgroundColor="AliceBlue">

    <!--ESTILOS IMPLICITOS: sin x:Key, se aplican solos a todos los controles del tipo-->
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="Navy"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontAttributes" Value="Bold"/>
        </Style>

        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="PlaceholderColor" Value="Gray"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style TargetType="Picker">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="TitleColor" Value="Gray"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="RoyalBlue"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label Text="REGISTRO DE CONTACTOS"
                   FontSize="22"
                   HorizontalOptions="Center" />

            <Image Source="contacto.png"
                   WidthRequest="120"
                   HeightRequest="120"/>

            <Label Text="Identificación:" />
            <Picker x:Name="pkTipoId"
                    Title="Seleccione el tipo"
                    SelectedIndexChanged="pkTipoId_SelectedIndexChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>CI</x:String>
                        <x:String>RUC</x:String>
                        <x:String>Pasaporte</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <Entry x:Name="txtNumeroId"
                   Placeholder="Seleccione primero el tipo"
                   IsEnabled="False"
                   TextChanged="txtNumeroId_TextChanged" />

            <Label Text="Nombres:" />
            <Entry x:Name="txtNombres" Placeholder="Nombres" TextChanged="SoloLetras_TextChanged" />

            <Label Text="Apellidos:" />
            <Entry x:Name="txtApellidos" Placeholder="Apellidos" TextChanged="SoloLetras_TextChanged" />

            <Label Text="Fecha:" />
            <DatePicker x:Name="dpFecha" Format="dd/MM/yyyy" />

            <Label Text="Correo:" />
            <Entry x:Name="txtCorreo" Placeholder="correo@ejemplo.com" Keyboard="Email" />

            <Label Text="Salario:" />
            <Entry x:Name="txtSalario" Placeholder="0.00" Keyboard="Numeric" TextChanged="SoloDecimales_TextChanged" />

            <Grid ColumnSpacing="15" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnGuardar"
                        Text="Guardar"
                        Clicked="btnGuardar_Clicked"
                        Grid.Column="0"/>
                <Button x:Name="btnLimpiar"
                        Text="Limpiar"
                        Clicked="btnLimpiar_Clicked"
                        Grid.Column="1"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
